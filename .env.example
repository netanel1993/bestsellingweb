# ── Site ────────────────────────────────────────────────────────────────────
# Public URL used for canonical, OG, sitemap
NEXT_PUBLIC_SITE_URL=https://bestsellingweb.com

# basePath for GitHub Pages deployment (leave empty for custom domain / Vercel)
NEXT_PUBLIC_BASE_PATH=

# ── AliExpress Affiliate ─────────────────────────────────────────────────────
# Your tracking id from AliExpress Portals → Tools → Tracking IDs
NEXT_PUBLIC_ALIEXPRESS_TRACKING_ID=

# ── AliExpress Open Platform API ─────────────────────────────────────────────
# Get these from: https://portals.aliexpress.com → Tools → API
# App Key  (also called App ID)
ALIEXPRESS_APP_KEY=

# App Secret
ALIEXPRESS_APP_SECRET=

# ── Product fetch options (optional) ─────────────────────────────────────────
# Target country code for pricing / shipping info (default: US)
ALIEXPRESS_SHIP_TO=US

# Products per API page, max 50 (default: 50)
ALIEXPRESS_PAGE_SIZE=50

# Pages per category (default: 2 → up to 100 products per category)
ALIEXPRESS_PAGES=2

# Minimum star rating to include a product (default: 4.5)
ALIEXPRESS_MIN_RATING=4.5

# Minimum order count to include a product (default: 500)
ALIEXPRESS_MIN_ORDERS=500

# ── SEO ──────────────────────────────────────────────────────────────────────
# Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
