# Public site URL - used for canonical, OG, sitemap
NEXT_PUBLIC_SITE_URL=https://bestsellingweb.com

# Your AliExpress affiliate tracking id (aff_fcid / tracking_key).
# If set, the /go/[id] redirect appends it to every outgoing URL.
NEXT_PUBLIC_ALIEXPRESS_TRACKING_ID=

# Optional Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
